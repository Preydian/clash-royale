# Frontend (Vite) — base URL for the API.
# Local dev: point at the Express server.
# Vercel:    leave UNSET so the frontend uses same-origin relative /api/... URLs.
VITE_API_BASE=http://localhost:5000

# Frontend (Vite) — comma-separated player tags to auto-populate on ComparePage.
# Each browser overrides this via localStorage after the first add/remove.
# IMPORTANT: must be double-quoted because tag values start with # (the .env comment char).
# Optional. Example: VITE_DEFAULT_TAGS="#VLYY90PPY,#VCGU20LGL"
VITE_DEFAULT_TAGS=

# Backend (server/server.js AND Vercel function) — Supercell developer token.
# Local: also lives in server/.env so node server/server.js picks it up.
# Vercel: set in Project Settings → Environment Variables (NOT in this file).
CLASH_KEY=
