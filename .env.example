# Frontend (Vite) — base URL for the API. Optional.
# Leave UNSET to use same-origin /api/... URLs: `npm run dev` serves them
# itself (see vite.config.ts), and so does Vercel. Only set it to point at the
# standalone Express server, e.g. http://localhost:5000.
# VITE_API_BASE=

# Frontend (Vite) — comma-separated player tags, listed under "Your accounts"
# on the home page and loaded by "Load my accounts" on the Compare page.
# IMPORTANT: must be double-quoted because tag values start with # (the .env comment char).
# Optional. Example: VITE_DEFAULT_TAGS="#VLYY90PPY,#VCGU20LGL"
VITE_DEFAULT_TAGS=

# Backend (Vite dev server, server/server.js AND Vercel function) — Supercell
# developer token. Never exposed to the browser (no VITE_ prefix).
# Local: `npm run dev` reads it from this .env; server/server.js reads server/.env.
# Vercel: set in Project Settings → Environment Variables (NOT in this file).
CLASH_KEY=

# Backend — optional override for the upstream API. Defaults: the RoyaleAPI
# proxy (https://proxy.royaleapi.dev/v1) for `npm run dev` and Vercel, whose IP
# 45.79.218.79 must be whitelisted on the key; the official API for
# server/server.js, which needs your own IP whitelisted.
# CLASH_API_BASE=
