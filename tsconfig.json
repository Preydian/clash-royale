{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2022",
    "noImplicitAny": true,
    "moduleResolution": "node",
    "strictNullChecks": true,
    "sourceMap": true,
    "outDir": "dist",
    "types": ["node"],
    "baseUrl": ".",
    "noErrorTruncation": true,
    // "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "paths": {
      "*": ["node_modules/", "src/types/*"]
    }
  },
"include": ["src", "vite.config.ts"]
}
